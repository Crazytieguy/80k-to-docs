  {
    "title": "Research Program Coordinator",
    "post": {
      "company": {
        "name": "Constellation",
        "id_external_80_000_hours": "Constellation",
        "description": "<p><a target=\"_blank\" href=\"https://www.constellation.org/\">Constellation</a> is a center for collaborative research whose mission is to help the world safely navigate the development of transformative AI. They run various upskilling programs for AI safety researchers and manage a co-working space in Berkeley, California.</p>",
        "logo_url": "https://80000hours.org/wp-content/uploads/2026/03/const_logo-160x160.jpeg",
        "url": "https://www.constellation.org/",
        "linkedin_url": "",
        "facebook_url": "",
        "career_page_url": "https://www.constellation.org/careers",
        "created_at": "2023-07-13T08:58:15.850034Z",
        "updated_at": "2026-05-22T10:42:34.622946Z",
        "author": null
      },
      "id_external_80_000_hours": "recbXPMyUHNb8nS5P"
    },
    "description": "",
    "description_short": "<ul>\n<li>In this role, you'll own the operations and systems that support research programs building the AI safety field's talent pipeline.</li>\n<li>Maintain project plans, documentation, and team coordination systems to keep programs on track.</li>\n<li>Design and improve workflows, team structures, and communication platforms across research programs and their networks.</li>\n<li>Partner with research program managers on event programming, design, and logistics for technical workshops and educational sessions.</li>\n<li>Track process bottlenecks and implement improvements to increase team effectiveness and program quality.</li>\n</ul>",
    "url_external": "https://jobs.gem.com/constellation-institute/64106250-5fb4-4ff5-b562-cc279c57dc57?utm_source=80000hours&utm_medium=job-board",
