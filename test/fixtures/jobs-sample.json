        "author": null
      },
      "id_external_80_000_hours": "reciuWp0thykbtSat"
    },
    "description": "",
    "description_short": "<ul>\n<li>Senior Researchers at GiveWell are responsible for finding, researching, and recommending high-impact giving opportunities.</li>\n<li>Lead on conducting research to identify outstanding programs and explore questions that affect program evaluation and prioritization.</li>\n<li>Own complicated questions that inform analysis, such as improving cost-effectiveness modeling and prioritizing different program outcomes.</li>\n<li>Leverage skills in critical research review, empirical analysis, modeling, and logical reasoning to make practical recommendations.</li>\n<li>Communicate findings clearly, ask probing questions, and execute research that withstands scrutiny over time.</li>\n</ul>",
    "url_external": "https://job-boards.greenhouse.io/givewell/jobs/4253692008?utm_source=80000hours&utm_medium=job-board",
