  {
    "title": "Senior Research Manager",
    "post": {
      "company": {
        "name": "MATS Research",
        "id_external_80_000_hours": "MATS Research",
        "description": "<p>The <a target=\"_blank\" href=\"https://www.matsprogram.org/\">Machine Alignment, Transparency, and Security (MATS) Program</a> is an educational seminar and independent research program that aims to provide talented scholars with talks, workshops, and research mentorship in the field of AI alignment, and connect them with the Berkeley AI safety research community.</p>",
        "logo_url": "https://80000hours.org/wp-content/uploads/2023/10/MATS-160x160.jpeg",
        "url": "https://www.matsprogram.org/",
        "linkedin_url": "",
        "facebook_url": "",
        "career_page_url": "https://www.matsprogram.org/jobs/#job-descriptions",
        "created_at": "2025-12-10T12:13:37.324312Z",
        "updated_at": "2026-05-22T10:42:20.002889Z",
        "author": null
      },
      "id_external_80_000_hours": "rec9enXKqMpDioTCF"
    },
    "description": "",
    "description_short": "<ul>\n<li>In this role, you'll lead a team of Research Managers supporting AI safety researchers while developing leadership capabilities in a high-impact field.</li>\n<li>Manage and develop Research Managers through weekly 1:1s, providing actionable feedback and driving their professional growth.</li>\n<li>Contribute to research management processes and excellence by piloting and documenting new approaches.</li>\n<li>Ensure scholars complete essential milestones, meet mentor goals, and receive appropriate resources.</li>\n<li>Partner with mentors to clarify research goals and accelerate their mentorship process.</li>\n</ul>",
    "url_external": "https://www.matsprogram.org/careers/senior-research-manager-berkeley-london?utm_source=80000hours&utm_medium=job-board",
